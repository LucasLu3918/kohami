{
  "name": "kohami-foundation-storefront",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host localhost",
    "build": "nuxt build",
    "build:public-demo": "node scripts/build-public-demo.mjs",
    "deploy:public-demo": "npm run build:public-demo && wrangler deploy --config wrangler.public-demo.json",
    "preview:public-demo": "wrangler dev --config wrangler.public-demo.json --ip 127.0.0.1",
    "test:data-source": "node --test tests/data-source.test.mjs tests/public-demo-worker.test.mjs tests/demo-asset-derivatives.test.mjs",
    "encode:demo-webp": "node scripts/encode-demo-webp.mjs",
    "test:data-source:browser": "playwright test --config playwright.data-source.config.ts",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@phosphor-icons/vue": "2.2.1",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "26.0.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.6",
    "wrangler": "4.151.3"
  }
}
