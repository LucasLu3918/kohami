{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kohami",
  "main": "./apps/storefront/worker/public-demo.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./apps/storefront/.output/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v1", "/api/v1/*"]
  },
  "previews": {},
  "build": {
    "command": "npm ci --prefix apps/storefront && npm --prefix apps/storefront run test:data-source && npm --prefix apps/storefront run typecheck && npm --prefix apps/storefront run build:public-demo"
  }
}
